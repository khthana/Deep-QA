# Secrets — never commit. See .env.example for the shape.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
build/
dist/

# Uploaded evidence files (runtime data, not source)
uploads/
DEEP-QA-BACKEND/uploads/

# Local-only material. Travels with a folder copy, never with a clone.
# See _local/README.md for what lives here.
_local/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Mutation harness backups - the untouched copies of whatever a mutant is about
mutation/.backup/
__pycache__/
*.pyc
