# Where the API answers. The backend allows exactly this application's origin
# through CORS, so the two have to agree: FRONTEND_URL in the backend's .env
# names the value of PORT below.
REACT_APP_API_URL=http://localhost:3000

# Where the "go to Deep Portfolio" controls send people — #50. Optional; unset
# falls back to the production address in src/lib/links.js.
REACT_APP_PORTFOLIO_URL=https://portfolio.deep-core.net/teacher

PORT=5000
