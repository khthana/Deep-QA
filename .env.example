# Copy to DEEP-QA-BACKEND/.env (and later backend/.env) and fill in real values.
# Never commit the filled-in file.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5000

# PostgreSQL — Ticket 0 provisions these via docker compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=deep_qa
DB_SCHEMA=deep_core

# Auth
SECRET_KEY=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail
EMAIL_USER=
EMAIL_PASS=

# Scoring
MAX_SCORE=
