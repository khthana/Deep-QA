# Template for the environment files. Copy the relevant section, fill in real
# values, and never commit the result — the repository is public.
#
# Two files are needed today, both gitignored:
#   DEEP-QA-BACKEND/.env    (backend section below)
#   DEEP-QA-FRONTEND/.env   (frontend section below)
# The rebuild adds backend/.env and frontend/.env with the same shapes.

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5000

# PostgreSQL — provisioned by docker compose in ticket #2
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=deep_qa
DB_SCHEMA=deep_core

# Auth. SECRET_KEY signs the session JWT; SESSION_SECRET signs the session
# cookie. Generate each with: openssl rand -base64 32
SECRET_KEY=
SESSION_SECRET=

# Google OAuth. Not needed for local development — password sign-in is open to
# every role when NODE_ENV=development. Required only against a real
# deployment, where the redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound mail for account verification
EMAIL_USER=
EMAIL_PASS=

# Scoring
MAX_SCORE=

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
# Points at the backend. Every request is sent with credentials included, so
# this must match the origin the backend allows.
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_GOOGLE=http://localhost:3000/api/auth/google-login
PORT=5000
