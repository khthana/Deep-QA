# Template for the environment files. Copy the relevant section, fill in real
# values, and never commit the result — the repository is public.
#
# `cp .env.example .env` at the repository root is the first step of local
# setup: that root .env is what db/ reads. Whether the rebuilt backend and
# frontend read the same file or their own is settled by their tickets — a CRA
# frontend, for one, only reads a .env in its own directory. The read-only
# reference trees keep their own DEEP-QA-BACKEND/.env and DEEP-QA-FRONTEND/.env.
# All are gitignored.

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5000

# PostgreSQL — provisioned by db/docker-compose.yml. DB_USER and DB_PASS are
# what the container is created with, so changing them after the volume exists
# has no effect until the volume is destroyed (npm run db:down -- -v).
# DB_SCHEMA is set on the connection search path; queries name bare tables.
DB_HOST=localhost
# 5433, not 5432: a PostgreSQL installed directly on the machine already owns
# 5432, and the two are indistinguishable from the client's side. DB_PORT is
# both the port the container publishes and the port the pool dials.
DB_PORT=5433
DB_USER=deep_core
DB_PASS=deep_core_local_only
DB_NAME=deep_qa
DB_SCHEMA=deep_core

# Auth. SECRET_KEY signs the session JWT, which is the whole session: #8 keeps
# it in an HttpOnly cookie and mounts no express-session, so the inherited
# SESSION_SECRET has nothing left to sign and is gone. Generate with:
# openssl rand -base64 32
SECRET_KEY=

# Google OAuth. Not needed for local development — password sign-in is open to
# every role when NODE_ENV=development. Required only against a real
# deployment, where the redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound mail for account verification
EMAIL_USER=
EMAIL_PASS=

# Scoring
MAX_SCORE=

# ─────────────────────────────────────────────────────────────
# Frontend — copy this section into `frontend/.env`, not the root .env
# ─────────────────────────────────────────────────────────────
# Settled by #7: a CRA dev server and the backend both read PORT, and dotenv
# lets the last assignment in a file win, so a root .env holding both hands the
# backend the frontend's port. The frontend reads a .env in its own directory
# anyway; this section belongs there.
#
# REACT_APP_API_URL points at the backend. Every request is sent with
# credentials included, so it must match the origin the backend allows.
REACT_APP_API_URL=http://localhost:3000
#
# Where the "go to Deep Portfolio" controls send people — #50. The two
# applications deploy together, and until this existed the address was written
# out twice as a literal, so a staging DEEP-QA pointed both of them at the live
# portfolio. Optional: unset falls back to the production address.
REACT_APP_PORTFOLIO_URL=https://portfolio.deep-core.net/teacher
PORT=5000

# Removed at #50: REACT_APP_API_GOOGLE. Nothing read it. `Login.js` builds that
# address out of REACT_APP_API_URL, so a person who changed this one and
# expected the Google button to follow would have been changing nothing.
